# Folder where project JSON files are stored (git-ignored).
DATA_DIR=./data

# 32-byte key, base64, used to encrypt the Figma token at rest (Prompt 7).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-me

# Optional: switches on AI suggestions for ambiguous Figma frames (Components screen).
# Leave empty to keep them off; name-based matching works without it.
ANTHROPIC_API_KEY=
