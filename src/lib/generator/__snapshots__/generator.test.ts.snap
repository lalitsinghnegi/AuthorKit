exports[`generatePackage > matches the snapshot (desktop-first) > desktop-first: css/components/accordion.css 1`] = `
"/*!
 * Acme Health · css/components/accordion.css
 * Accordion. Generated by AuthorKit; regenerate instead of editing by hand.
 *
 * Variables used:
 *   --acme-accordion-border-color
 *   --acme-accordion-padding-y
 *   --acme-accordion-title-size
 *   --acme-border-width
 *   --acme-color-border
 *   --acme-color-focus
 *   --acme-color-heading
 *   --acme-color-link
 *   --acme-duration-fast
 *   --acme-font-size-lg
 *   --acme-font-weight-bold
 *   --acme-size-focus-offset
 *   --acme-size-focus-ring
 *   --acme-size-icon
 *   --acme-space-4
 */

.acme-accordion {
  --acme-accordion-border-color: var(--acme-color-border);
  --acme-accordion-padding-y: var(--acme-space-4);
  --acme-accordion-title-size: var(--acme-font-size-lg);

  border-top: var(--acme-border-width) solid var(--acme-accordion-border-color);
}

.acme-accordion__item {
  border-bottom: var(--acme-border-width) solid var(--acme-accordion-border-color);
}

.acme-accordion__heading {
  margin: 0;
  font-size: inherit;
}

.acme-accordion__trigger {
  display: flex;
  gap: var(--acme-space-4);
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: var(--acme-accordion-padding-y) 0;
  border: 0;
  background-color: transparent;
  color: var(--acme-color-heading);
  font: inherit;
  font-size: var(--acme-accordion-title-size);
  font-weight: var(--acme-font-weight-bold);
  text-align: left;
  cursor: pointer;
}

.acme-accordion__trigger:hover {
  color: var(--acme-color-link);
}

.acme-accordion__trigger:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus);
  outline-offset: var(--acme-size-focus-offset);
}

.acme-accordion__icon {
  flex: none;
  width: var(--acme-size-icon);
  height: var(--acme-size-icon);
  transition: transform var(--acme-duration-fast) ease;
}

.acme-accordion__trigger[aria-expanded="true"] .acme-accordion__icon {
  transform: rotate(180deg);
}

.acme-accordion__panel {
  padding: 0 0 var(--acme-accordion-padding-y);
}

.acme-accordion__panel[hidden] {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .acme-accordion__icon {
    transition: none;
  }
}

/* @authorkit-responsive accordion · tablet (768px – 1023px): no overrides */

/* @authorkit-responsive accordion · mobile (≤ 767px): no overrides */
"
`;

exports[`generatePackage > matches the snapshot (desktop-first) > desktop-first: css/components/cta.css 1`] = `
"/*!
 * Acme Health · css/components/cta.css
 * CTA buttons. Generated by AuthorKit; regenerate instead of editing by hand.
 *
 * Variables used:
 *   --acme-border-width
 *   --acme-btn-bg
 *   --acme-btn-bg-hover
 *   --acme-btn-border-color
 *   --acme-btn-border-color-hover
 *   --acme-btn-color
 *   --acme-btn-color-hover
 *   --acme-btn-font-size
 *   --acme-btn-padding-x
 *   --acme-btn-padding-y
 *   --acme-btn-radius
 *   --acme-color-disabled-background
 *   --acme-color-disabled-text
 *   --acme-color-focus
 *   --acme-color-link
 *   --acme-color-link-hover
 *   --acme-color-on-primary
 *   --acme-color-primary
 *   --acme-color-primary-hover
 *   --acme-duration-fast
 *   --acme-font-size-base
 *   --acme-font-weight-bold
 *   --acme-line-height-tight
 *   --acme-radius-pill
 *   --acme-size-focus-offset
 *   --acme-size-focus-ring
 *   --acme-size-icon
 *   --acme-space-2
 *   --acme-space-3
 *   --acme-space-5
 */

.acme-btn {
  --acme-btn-bg: transparent;
  --acme-btn-color: var(--acme-color-primary);
  --acme-btn-border-color: var(--acme-color-primary);
  --acme-btn-bg-hover: var(--acme-color-primary);
  --acme-btn-color-hover: var(--acme-color-on-primary);
  --acme-btn-border-color-hover: var(--acme-color-primary);
  --acme-btn-padding-y: var(--acme-space-3);
  --acme-btn-padding-x: var(--acme-space-5);
  --acme-btn-radius: var(--acme-radius-pill);
  --acme-btn-font-size: var(--acme-font-size-base);

  display: inline-flex;
  gap: var(--acme-space-2);
  align-items: center;
  justify-content: center;
  padding: var(--acme-btn-padding-y) var(--acme-btn-padding-x);
  border: var(--acme-border-width) solid var(--acme-btn-border-color);
  border-radius: var(--acme-btn-radius);
  background-color: var(--acme-btn-bg);
  color: var(--acme-btn-color);
  font-family: inherit;
  font-size: var(--acme-btn-font-size);
  font-weight: var(--acme-font-weight-bold);
  line-height: var(--acme-line-height-tight);
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition:
    background-color var(--acme-duration-fast) ease,
    border-color var(--acme-duration-fast) ease,
    color var(--acme-duration-fast) ease;
}

.acme-btn:hover {
  border-color: var(--acme-btn-border-color-hover);
  background-color: var(--acme-btn-bg-hover);
  color: var(--acme-btn-color-hover);
}

.acme-btn:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus);
  outline-offset: var(--acme-size-focus-offset);
}

/* Variants */
.acme-btn--primary {
  --acme-btn-bg: var(--acme-color-primary);
  --acme-btn-color: var(--acme-color-on-primary);
  --acme-btn-border-color: var(--acme-color-primary);
  --acme-btn-bg-hover: var(--acme-color-primary-hover);
  --acme-btn-color-hover: var(--acme-color-on-primary);
  --acme-btn-border-color-hover: var(--acme-color-primary-hover);
}

.acme-btn--secondary {
  --acme-btn-bg: transparent;
  --acme-btn-color: var(--acme-color-primary);
  --acme-btn-border-color: var(--acme-color-primary);
  --acme-btn-bg-hover: var(--acme-color-primary);
  --acme-btn-color-hover: var(--acme-color-on-primary);
  --acme-btn-border-color-hover: var(--acme-color-primary);
}

.acme-btn--tertiary {
  --acme-btn-bg: transparent;
  --acme-btn-color: var(--acme-color-link);
  --acme-btn-border-color: transparent;
  --acme-btn-bg-hover: transparent;
  --acme-btn-color-hover: var(--acme-color-link-hover);
  --acme-btn-border-color-hover: transparent;
  --acme-btn-padding-x: 0;

  text-decoration: underline;
}

.acme-btn--block {
  display: flex;
  width: 100%;
}

.acme-btn__icon {
  flex: none;
  width: var(--acme-size-icon);
  height: var(--acme-size-icon);
}

/* Disabled: after the variants so it wins over all of them */
.acme-btn:disabled,
.acme-btn[aria-disabled="true"] {
  --acme-btn-bg: var(--acme-color-disabled-background);
  --acme-btn-color: var(--acme-color-disabled-text);
  --acme-btn-border-color: var(--acme-color-disabled-background);
  --acme-btn-bg-hover: var(--acme-color-disabled-background);
  --acme-btn-color-hover: var(--acme-color-disabled-text);
  --acme-btn-border-color-hover: var(--acme-color-disabled-background);

  cursor: not-allowed;
}

@media (prefers-reduced-motion: reduce) {
  .acme-btn {
    transition: none;
  }
}

/* @authorkit-responsive cta · tablet (768px – 1023px): no overrides */

/* @authorkit-responsive cta · mobile (≤ 767px): no overrides */
"
`;

exports[`generatePackage > matches the snapshot (desktop-first) > desktop-first: css/components/footer.css 1`] = `
"/*!
 * Acme Health · css/components/footer.css
 * Footer. Generated by AuthorKit; regenerate instead of editing by hand.
 *
 * Variables used:
 *   --acme-color-focus-inverse
 *   --acme-color-footer-background
 *   --acme-color-footer-link
 *   --acme-color-footer-text
 *   --acme-font-size-sm
 *   --acme-footer-align
 *   --acme-footer-bg
 *   --acme-footer-color
 *   --acme-footer-direction
 *   --acme-footer-link-color
 *   --acme-footer-padding-y
 *   --acme-size-container-max
 *   --acme-size-focus-offset
 *   --acme-size-focus-ring
 *   --acme-size-gutter
 *   --acme-size-logo-height
 *   --acme-space-3
 *   --acme-space-5
 *   --acme-space-7
 */

.acme-footer {
  --acme-footer-direction: row;
  --acme-footer-align: center;
  --acme-footer-bg: var(--acme-color-footer-background);
  --acme-footer-color: var(--acme-color-footer-text);
  --acme-footer-link-color: var(--acme-color-footer-link);
  --acme-footer-padding-y: var(--acme-space-7);

  background-color: var(--acme-footer-bg);
  color: var(--acme-footer-color);
  font-size: var(--acme-font-size-sm);
}

.acme-footer__inner {
  display: flex;
  flex-direction: var(--acme-footer-direction);
  gap: var(--acme-space-5);
  align-items: var(--acme-footer-align);
  justify-content: space-between;
  max-width: var(--acme-size-container-max);
  margin: 0 auto;
  padding: var(--acme-footer-padding-y) var(--acme-size-gutter);
}

.acme-footer__logo {
  display: inline-flex;
  color: inherit;
}

.acme-footer__logo img {
  display: block;
  width: auto;
  height: var(--acme-size-logo-height);
}

.acme-footer__links {
  display: flex;
  flex-wrap: wrap;
  gap: var(--acme-space-3) var(--acme-space-5);
  margin: 0;
  padding: 0;
  list-style: none;
}

.acme-footer__links li + li {
  margin-top: 0;
}

.acme-footer__link {
  color: var(--acme-footer-link-color);
  text-decoration: underline;
}

.acme-footer__link:hover {
  color: var(--acme-footer-link-color);
  text-decoration: none;
}

.acme-footer__logo:focus-visible,
.acme-footer__link:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus-inverse);
  outline-offset: var(--acme-size-focus-offset);
}

.acme-footer__legal,
.acme-footer__copyright {
  margin: 0;
}

/* @authorkit-responsive footer · tablet (768px – 1023px) */
@media (max-width: 1023px) {
  .acme-footer {
    --acme-footer-direction: column;
    --acme-footer-align: flex-start;
  }
}

/* @authorkit-responsive footer · mobile (≤ 767px): no overrides */
"
`;

exports[`generatePackage > matches the snapshot (desktop-first) > desktop-first: css/components/header.css 1`] = `
"/*!
 * Acme Health · css/components/header.css
 * Header. Generated by AuthorKit; regenerate instead of editing by hand.
 *
 * Variables used:
 *   --acme-border-width
 *   --acme-color-border
 *   --acme-color-focus
 *   --acme-color-header-background
 *   --acme-color-link
 *   --acme-color-text
 *   --acme-font-weight-bold
 *   --acme-header-bg
 *   --acme-header-color
 *   --acme-header-list-direction
 *   --acme-header-nav-display
 *   --acme-header-nav-padding
 *   --acme-header-nav-position
 *   --acme-header-nav-shadow
 *   --acme-header-shadow
 *   --acme-header-toggle-display
 *   --acme-radius-sm
 *   --acme-shadow-md
 *   --acme-shadow-sm
 *   --acme-size-container-max
 *   --acme-size-focus-offset
 *   --acme-size-focus-ring
 *   --acme-size-gutter
 *   --acme-size-header-height
 *   --acme-size-logo-height
 *   --acme-size-touch-target
 *   --acme-space-2
 *   --acme-space-4
 *   --acme-space-5
 *   --acme-z-header
 */

.acme-header {
  --acme-header-toggle-display: none;
  --acme-header-nav-display: block;
  --acme-header-nav-position: static;
  --acme-header-nav-padding: 0;
  --acme-header-nav-shadow: none;
  --acme-header-list-direction: row;
  --acme-header-bg: var(--acme-color-header-background);
  --acme-header-color: var(--acme-color-text);
  --acme-header-shadow: var(--acme-shadow-sm);

  position: relative;
  z-index: var(--acme-z-header);
  background-color: var(--acme-header-bg);
  color: var(--acme-header-color);
  box-shadow: var(--acme-header-shadow);
}

.acme-header--sticky {
  position: sticky;
  top: 0;
}

.acme-header__inner {
  display: flex;
  gap: var(--acme-space-4);
  align-items: center;
  justify-content: space-between;
  max-width: var(--acme-size-container-max);
  min-height: var(--acme-size-header-height);
  margin: 0 auto;
  padding: 0 var(--acme-size-gutter);
}

.acme-header__logo {
  display: inline-flex;
  align-items: center;
  color: inherit;
  text-decoration: none;
}

.acme-header__logo img {
  display: block;
  width: auto;
  height: var(--acme-size-logo-height);
}

/* Menu button: shown on small screens, hidden where the nav fits inline */
.acme-header__toggle {
  display: var(--acme-header-toggle-display);
  align-items: center;
  justify-content: center;
  min-width: var(--acme-size-touch-target);
  min-height: var(--acme-size-touch-target);
  padding: var(--acme-space-2);
  border: var(--acme-border-width) solid var(--acme-color-border);
  border-radius: var(--acme-radius-sm);
  background-color: transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
}

.acme-header__nav {
  display: var(--acme-header-nav-display);
  position: var(--acme-header-nav-position);
  top: 100%;
  right: 0;
  left: 0;
  padding: var(--acme-header-nav-padding);
  background-color: var(--acme-header-bg);
  box-shadow: var(--acme-header-nav-shadow);
}

/* Open state: the toggle sits directly before the nav and carries aria-expanded */
.acme-header__toggle[aria-expanded="true"] + .acme-header__nav {
  display: block;
}

.acme-header__list {
  display: flex;
  flex-direction: var(--acme-header-list-direction);
  gap: var(--acme-space-2) var(--acme-space-5);
  margin: 0;
  padding: 0;
  list-style: none;
}

.acme-header__list li + li {
  margin-top: 0;
}

.acme-header__link {
  display: block;
  padding: var(--acme-space-2) 0;
  color: var(--acme-header-color);
  font-weight: var(--acme-font-weight-bold);
  text-decoration: none;
}

.acme-header__link:hover,
.acme-header__link[aria-current="page"] {
  color: var(--acme-color-link);
  text-decoration: underline;
}

.acme-header__toggle:focus-visible,
.acme-header__link:focus-visible,
.acme-header__logo:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus);
  outline-offset: var(--acme-size-focus-offset);
}

/* @authorkit-responsive header · tablet (768px – 1023px) */
@media (max-width: 1023px) {
  .acme-header {
    --acme-header-toggle-display: inline-flex;
    --acme-header-nav-display: none;
    --acme-header-nav-position: absolute;
    --acme-header-nav-padding: var(--acme-space-4) var(--acme-size-gutter);
    --acme-header-nav-shadow: var(--acme-shadow-md);
    --acme-header-list-direction: column;
  }
}

/* @authorkit-responsive header · mobile (≤ 767px): no overrides */
"
`;

