  font-size: var(--acme-font-size-base);
  font-weight: var(--acme-font-weight-regular);
  line-height: var(--acme-line-height-body);
}

img {
  max-width: 100%;
  height: auto;
}

/* Headings: elements, plus classes for a visual level that differs from the semantic one */
h1,
h2,
h3,
h4,
h5,
h6,
.acme-h1,
.acme-h2,
.acme-h3,
.acme-h4,
.acme-h5,
.acme-h6 {
  margin-top: 0;
  margin-bottom: var(--acme-space-4);
  color: var(--acme-color-heading);
  font-family: var(--acme-font-family-heading);
  font-weight: var(--acme-font-weight-bold);
  line-height: var(--acme-line-height-heading);
  letter-spacing: var(--acme-letter-spacing-heading);
}

h1,
.acme-h1 {
