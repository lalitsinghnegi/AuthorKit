  flex: none;
  align-items: center;
  justify-content: center;
  width: var(--acme-size-touch-target);
  height: var(--acme-size-touch-target);
  padding: 0;
  border: 0;
  border-radius: var(--acme-radius-pill);
  background-color: transparent;
  color: inherit;
  font: inherit;
  font-size: var(--acme-font-size-lg);
  cursor: pointer;
}

.acme-modal__close:hover {
  background-color: var(--acme-color-surface);
}

.acme-modal__close:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus);
  outline-offset: var(--acme-size-focus-offset);
}

.acme-modal__body {
  overflow-y: auto;
  padding: var(--acme-modal-padding);
}

.acme-modal__footer {
  display: flex;
  flex: none;
  flex-wrap: wrap;
  gap: var(--acme-space-3);
  justify-content: flex-end;
  padding: 0 var(--acme-modal-padding) var(--acme-modal-padding);
}

/* Leaving-site / interstitial warning */
.acme-modal--interstitial {
  --acme-modal-width: var(--acme-size-modal-narrow);
}

/* Set on <body> while a modal is open to stop the page scrolling behind it */
.acme-modal-open {
  overflow: hidden;
}

