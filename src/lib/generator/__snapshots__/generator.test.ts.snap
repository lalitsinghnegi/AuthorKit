 *   --acme-size-isi-bar-expanded
 *   --acme-size-touch-target
 *   --acme-space-2
 *   --acme-space-3
 *   --acme-space-4
 *   --acme-space-5
 *   --acme-space-6
 *   --acme-z-isi-bar
 */

/* In-page Important Safety Information */
.acme-isi {
  --acme-isi-bg: var(--acme-color-isi-background);
  --acme-isi-color: var(--acme-color-isi-text);
  --acme-isi-padding-y: var(--acme-space-6);

  padding: var(--acme-isi-padding-y) var(--acme-size-gutter);
  background-color: var(--acme-isi-bg);
  color: var(--acme-isi-color);
  font-size: var(--acme-font-size-sm);
  line-height: var(--acme-line-height-body);
}

.acme-isi__content {
  max-width: var(--acme-size-container-max);
  margin: 0 auto;
}

.acme-isi__title {
  margin: 0 0 var(--acme-space-3);
  color: var(--acme-color-isi-heading);
  font-size: var(--acme-font-size-lg);
  font-weight: var(--acme-font-weight-bold);
}

.acme-isi__section + .acme-isi__section {
  margin-top: var(--acme-space-5);
}

/* Sticky safety bar: collapsed by default, expanded with the modifier */
.acme-isi-bar {
  --acme-isi-bar-max-height: var(--acme-size-isi-bar-collapsed);
  --acme-isi-bar-bg: var(--acme-color-isi-background);
  --acme-isi-bar-color: var(--acme-color-isi-text);

  display: flex;
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--acme-z-isi-bar);
  flex-direction: column;
  max-height: var(--acme-isi-bar-max-height);
  background-color: var(--acme-isi-bar-bg);
  color: var(--acme-isi-bar-color);
  box-shadow: var(--acme-shadow-lg);
  transition: max-height var(--acme-duration-base) ease;
}

.acme-isi-bar--expanded {
  --acme-isi-bar-max-height: var(--acme-size-isi-bar-expanded);
}

.acme-isi-bar__header {
  display: flex;
  flex: none;
  gap: var(--acme-space-3);
  align-items: center;
  justify-content: space-between;
  padding: var(--acme-space-3) var(--acme-size-gutter);
  border-bottom: var(--acme-border-width) solid var(--acme-color-border);
}

.acme-isi-bar__title {
  margin: 0;
  color: var(--acme-color-isi-heading);
  font-size: var(--acme-font-size-base);
  font-weight: var(--acme-font-weight-bold);
}

.acme-isi-bar__toggle {
  display: inline-flex;
  flex: none;
  gap: var(--acme-space-2);
  align-items: center;
  min-height: var(--acme-size-touch-target);
  padding: var(--acme-space-2) var(--acme-space-4);
  border: var(--acme-border-width) solid currentcolor;
  border-radius: var(--acme-radius-pill);
  background-color: transparent;
