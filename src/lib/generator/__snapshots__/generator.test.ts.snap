  margin-bottom: var(--acme-space-4);
  padding-left: var(--acme-space-5);
}

li + li {
  margin-top: var(--acme-space-2);
}

/* Focus */
:focus-visible {
  outline: var(--acme-size-focus-ring) solid var(--acme-color-focus);
  outline-offset: var(--acme-size-focus-offset);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0s !important;
    animation-duration: 0s !important;
  }
}

