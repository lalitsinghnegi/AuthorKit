{
  "id": "tokens",
  "name": "Design tokens",
  "description": "Every design value as a CSS custom property on :root: colors, type scale, spacing, radius, borders, shadows, z-index, motion and sizes. All other files read from these.",
  "fileName": "tokens.css",
  "selectors": [
    {
      "type": "html-element",
      "selector": ":root",
      "purpose": "Holds every token as --{{prefix}}-* so components and authors can read them."
    }
  ],
  "states": [],
  "examples": [
    {
      "title": "Using a token in your own CSS",
      "html": "<div style=\"padding: var(--{{prefix}}-space-4); color: var(--{{prefix}}-color-primary)\">Uses the brand tokens</div>"
    }
  ],
  "accessibility": [
    "Default text, link and button colors meet WCAG 2.2 AA contrast (4.5:1) on their backgrounds; focus colors meet 3:1.",
    "Re-check contrast whenever color tokens are overridden from Figma."
  ],
