{{> fileHeader}}

/* Base reset */
*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background-color: var(--{{prefix}}-color-background);
  color: var(--{{prefix}}-color-text);
  font-family: var(--{{prefix}}-font-family-base);
  font-size: var(--{{prefix}}-font-size-base);
  font-weight: var(--{{prefix}}-font-weight-regular);
  line-height: var(--{{prefix}}-line-height-body);
}

img {
  max-width: 100%;
  height: auto;
}

/* Headings: elements, plus classes for a visual level that differs from the semantic one */
h1,
h2,
h3,
h4,
h5,
h6,
.{{prefix}}-h1,
.{{prefix}}-h2,
.{{prefix}}-h3,
.{{prefix}}-h4,
.{{prefix}}-h5,
.{{prefix}}-h6 {
  margin-top: 0;
  margin-bottom: var(--{{prefix}}-space-4);
  color: var(--{{prefix}}-color-heading);
  font-family: var(--{{prefix}}-font-family-heading);
  font-weight: var(--{{prefix}}-font-weight-bold);
  line-height: var(--{{prefix}}-line-height-heading);
  letter-spacing: var(--{{prefix}}-letter-spacing-heading);
}

h1,
.{{prefix}}-h1 {
  font-size: var(--{{prefix}}-font-size-h1);
}

h2,
.{{prefix}}-h2 {
  font-size: var(--{{prefix}}-font-size-h2);
}

h3,
.{{prefix}}-h3 {
  font-size: var(--{{prefix}}-font-size-h3);
}

h4,
.{{prefix}}-h4 {
  font-size: var(--{{prefix}}-font-size-h4);
}

h5,
.{{prefix}}-h5 {
  font-size: var(--{{prefix}}-font-size-h5);
}

h6,
.{{prefix}}-h6 {
  font-size: var(--{{prefix}}-font-size-h6);
}

/* Text */
p {
  margin-top: 0;
  margin-bottom: var(--{{prefix}}-space-4);
}

sup,
sub {
  position: relative;
  font-size: var(--{{prefix}}-font-size-sup);
  line-height: 0;
  vertical-align: baseline;
}

sup {
  top: var(--{{prefix}}-size-sup-offset);
}

sub {
  bottom: var(--{{prefix}}-size-sub-offset);
}

/* Links */
a {
  color: var(--{{prefix}}-color-link);
  text-decoration: underline;
}

a:hover {
  color: var(--{{prefix}}-color-link-hover);
}

/* Lists */
ul,
ol {
  margin-top: 0;
  margin-bottom: var(--{{prefix}}-space-4);
  padding-left: var(--{{prefix}}-space-5);
}

li + li {
  margin-top: var(--{{prefix}}-space-2);
}

/* Focus */
:focus-visible {
  outline: var(--{{prefix}}-size-focus-ring) solid var(--{{prefix}}-color-focus);
  outline-offset: var(--{{prefix}}-size-focus-offset);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0s !important;
    animation-duration: 0s !important;
  }
}
{{> responsive}}
